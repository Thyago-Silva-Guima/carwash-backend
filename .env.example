#gere o app key com php artisan key:generate
APP_NAME="Car Wash"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

#Substitua o username e senha pelos que existem no seu banco de dados local
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_car_wash
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Agendamento (valores provisórios; o cliente final informa os reais)
AGENDA_PASSO=30
AGENDA_ANTEC_AGENDAR_H=2
AGENDA_ANTEC_CANCELAR_H=2
AGENDA_LIMITE_DIAS=90

# Google Agenda (conta de serviço). Vazios = sem Google em ambiente local/testes.
GOOGLE_CALENDAR_ID=
GOOGLE_APPLICATION_CREDENTIALS=

FRONTEND_URL=http://localhost:5173

#Obrigatórios para o db:seed criar o admin (senha com no mínimo 12 caracteres)
ADMIN_NAME="Administrador"
ADMIN_EMAIL=
ADMIN_PASSWORD=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="contato@exemplo.com"
MAIL_FROM_NAME="${APP_NAME}"